// Generated from the plotjuggler_sdk VERSION file. Do not edit.
//
// A development pre-release (X.Y.Z-dev.N) exposes the numeric core X.Y.Z through
// PJ_SDK_VERSION_*, so PJ_SDK_VERSION_AT_LEAST(X, Y, Z) is already true for it;
// sdkVersion() keeps the full string, and PJ::SemVer orders it below X.Y.Z.

#include <string_view>

#define PJ_SDK_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define PJ_SDK_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define PJ_SDK_VERSION_PATCH @PROJECT_VERSION_PATCH@

#define PJ_SDK_VERSION_AT_LEAST(major, minor, patch)                                                          \
  ((PJ_SDK_VERSION_MAJOR > (major)) || (PJ_SDK_VERSION_MAJOR == (major) && PJ_SDK_VERSION_MINOR > (minor)) || \
   (PJ_SDK_VERSION_MAJOR == (major) && PJ_SDK_VERSION_MINOR == (minor) && PJ_SDK_VERSION_PATCH >= (patch)))

namespace PJ {

/// Return the full plotjuggler_sdk version used to configure this header,
/// including any pre-release suffix (the PJ_SDK_VERSION_* macros omit it).
[[nodiscard]] inline constexpr std::string_view sdkVersion() noexcept {
  return "@PJ_SDK_VERSION@";
}

}  // namespace PJ
